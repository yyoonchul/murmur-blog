# Supabase Postgres (session or direct URI from Dashboard → Connect)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres

# JWT verification (Project URL + JWKS path)
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Comma-separated browser origins allowed for CORS (Vercel app URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: default LLM keys for all users (BYOK still overrides per user when set in Settings)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
